  <OpportunitySite_PeaceTalks.questDescriptionRules.rulesStrings>
    <li>questDescription-&gt;.ﺔﻟﺎﺳﺭ ،[faction_name] ﻦﻣ [faction_leader_nameFull]، [faction_leaderTitle] ﺎﻨﻴﻟﺇ ﻞﺳﺭﺃ\nﻊﻗﻮﻣ ﻲﻓ ﺎﻨﻌﻣ ﺙﺪﺤﺘﻟﺍ [faction_leader_pronoun] ﺪﻳﺮﻳ\n.ﺐﻳﺮﻗ\n\nﻦﻴﺴﺤﺘﻟ ﺔﻤﻴﻈﻋ ﺔﺻﺮﻓ ﻥﻮﻜﺗ ﺪﻗ\nﻲﻘﻠﺗﻭ ﻢﻬﻠﻴﺼﻓ ﻊﻣ ﺕﺎﻗﻼﻌﻟﺍ\nﺽﻭﺎﻔﻤﻟﺎﻓ - ﺭﺬﺣﺍ ﻦﻜﻟﻭ ،ﺎﻳﺍﺪﻬﻟﺍ\nﻦﻣ ﺮﺜﻛﺃ ﺭﺮﻀﺑ ﺐﺒﺴﺘﻳ ﺪﻗ ﻒﻴﻌﻀﻟﺍ\n[extraLeaderPart][favorRewardDetails].ﻢﻬﺒﻀﻏ ﺮﻴﺜﻳ ﺪﻗﻭ ﻊﻔﻨﻟﺍ</li>
    <li>favorRewardDetails(faction_leader_royalInCurrentFaction==True,priority=1)-&gt;\n\nﻥﺃ ﺔﺤﺟﺎﻨﻟﺍ ﻡﻼﺴﻟﺍ ﺕﺎﺛﺩﺎﺤﻤﻟ ﻦﻜﻤﻳ\n[faction_royalFavorLabel] ﻦﻣ ﺓﺮﻴﻐﺻ ﺔﻴﻤﻛ ﻢﻜﺿﻭﺎﻔﻣ ﺐﺴﻜﺗ\n.[faction_name] ﻯﺪﻟ ﺔﻴﺼﺨﺸﻟﺍ</li>
    <li>favorRewardDetails-&gt;</li>
    <li>extraLeaderPart(priority=1)-&gt;\n\n[leaderRoleEffect].[leaderPawnInfo]</li>
    <li>extraLeaderPart-&gt;</li>
    <li>leaderRoleEffect-&gt;ﺍﺫﺇ ﺮﺜﻛﺃ ﻯﺮﺧﻷﺍ ﻞﺋﺎﺼﻔﻟﺍ ﻚﻣﺮﺘﺤﺘﺳ\nﺕﺎﺿﻭﺎﻔﻤﻟﺍ ﻲﻟﻮﺘﻟ ﻙﺪﺋﺎﻗ ﺖﻠﺳﺭﺃ</li>
    <li>leaderPawnInfo(playerFaction_hasLeader==True,priority=1)-&gt;ﺔﺻﺮﻓ ﻲﻓ ﺓﺄﻓﺎﻜﻣ ﻰﻠﻋ [playerFaction_leaderTitle] [playerFaction_leader_nameFull] ﻞﺼﺤﻴﺳ\n.ﺔﺤﺟﺎﻨﻟﺍ ﺔﺠﻴﺘﻨﻟﺍ</li>
    <li>leaderPawnInfo-&gt;</li>
 </OpportunitySite_PeaceTalks.questDescriptionRules.rulesStrings>
