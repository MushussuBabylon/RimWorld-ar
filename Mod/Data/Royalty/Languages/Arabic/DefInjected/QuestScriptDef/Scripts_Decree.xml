<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must build a monument. It is [monumentSize] in size and will require these resources (total value [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\n[decreeThreatInfo]\n\nYou must keep the monument safe for [keepMonumentTicks_duration] after completion, otherwise [asker_nameDef] will be unhappy.</li>
  -->
  <Decree_BuildMonument.questDescriptionRules.rulesStrings>
    <li>questDescription-&gt;[decreeIntro]\n\nﻪﻤﺠﺣ .ﻱﺭﺎﻛﺬﺗ ﺐﺼﻧ ﺀﺎﻨﺑ ﻚﻴﻠﻋ ﺐﺠﻳ\nﺔﻤﻴﻘﻟﺍ) ﺩﺭﺍﻮﻤﻟﺍ ﻩﺬﻫ ﺐﻠﻄﺘﻴﺳﻭ [monumentSize]\n:([monumentRequiredResourcesMarketValue_money] ﺔﻴﻟﺎﻤﺟﻹﺍ\n\n[monumentRequiredResources]\n\n[decreeThreatInfo]\n\nﺐﺼﻨﻟﺍ ﺔﻣﻼﺳ ﻰﻠﻋ ﻆﻓﺎﺤﺗ ﻥﺃ ﺐﺠﻳ\n[asker_nameDef] ﻥﻮﻜﻴﺳ ﻻﺇﻭ ،ﻝﺎﻤﻛﻹﺍ ﺪﻌﺑ [keepMonumentTicks_duration] ﺓﺪﻤﻟ\n.ًﺀﺎﺘﺴﻣ</li>
 </Decree_BuildMonument.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->monument decree</li>
  -->
  <Decree_BuildMonument.questNameRules.rulesStrings>
    <li>questName-&gt;ﺐﺼﻨﻟﺍ ﺀﺎﻨﺑ ﻡﻮﺳﺮﻣ</li>
 </Decree_BuildMonument.questNameRules.rulesStrings>
  <!-- EN: New monument marker arrived -->
  <Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>ﺓﺪﻳﺪﺟ ﺐﺼﻧ ﺔﻣﻼﻋ ﺖﻠﺻﻭ</Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>
  <!-- EN: Since the monument marker has been destroyed, a new one has been sent. -->
  <Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>،ﺕﺮﻣُﺩ ﺪﻗ ﺐﺼﻨﻟﺍ ﺔﻣﻼﻋ ﻥﻷ ًﺍﺮﻈﻧ\n.ﺓﺪﻳﺪﺟ ﺓﺪﺣﺍﻭ ﻝﺎﺳﺭﺇ ﻢﺗ</Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>
  <!-- EN: Monument completed -->
  <Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>ﺐﺼﻨﻟﺍ ﻞﻤﺘﻛﺍ</Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>
  <!-- EN: You have completed construction of the monument.\n\nYou must keep it safe for [keepMonumentTicks_duration], otherwise [asker_nameDef] will be displeased. -->
  <Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>.ﺐﺼﻨﻟﺍ ﺀﺎﻨﺑ ﺖﻠﻤﻛﺃ ﺪﻘﻟ\n\nﺓﺪﻤﻟ ًﺎﻨﻣﺁ ﻪﻴﻠﻋ ﻆﻓﺎﺤﺗ ﻥﺃ ﺐﺠﻳ\n.ٍﺽﺍﺭ ﺮﻴﻏ [asker_nameDef] ﻥﻮﻜﻴﺳ ﻻﺇﻭ ،[keepMonumentTicks_duration]</Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>
  <!-- EN: Monument destroyed -->
  <Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>ﺮﻣﺪﻣ ﺐﺼﻧ</Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>
  <!-- EN: [asker_nameDef] is offended that you allowed the monument to be ruined so soon after completion.\n\n[asker_pronoun] will be unhappy about this. -->
  <Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>ﺮﻴﻣﺪﺘﺑ ﺖﺤﻤﺳ ﻚﻧﻷ ﺔﻧﺎﻫﻹﺎﺑ [asker_nameDef] ﺮﻌﺸﻳ\n.ﺓﺰﻴﺟﻭ ﺓﺮﺘﻔﺑ ﻪﻟﺎﻤﻛﺇ ﺪﻌﺑ ﺐﺼﻨﻟﺍ\n\n.ﺍﺬﻬﺑ ﺪﻴﻌﺳ ﺮﻴﻏ [asker_pronoun] ﻥﻮﻜﻴﺳ</Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>{0} ﺓﺪﻤﻟ ﺐﺼﻨﻟﺍ ﺮﻣﺪﺗ ﻻ</Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>{0} ﺓﺪﻤﻟ ﺐﺼﻨﻟﺍ ﺮﻣﺪﺗ ﻻ</Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>
  <!-- EN: Keep monument {0} -->
  <Decree_BuildMonument.KeepMonument.slateRef>{0} ﺐﺼﻨﻟﺍ ﻰﻠﻋ ﻆﻓﺎﺣ</Decree_BuildMonument.KeepMonument.slateRef>
  
  <!-- EN:
