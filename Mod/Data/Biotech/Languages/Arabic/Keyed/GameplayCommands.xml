<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: Auto-repair -->
  <CommandAutoRepair>ﻲﺋﺎﻘﻠﺗ ﺡﻼﺻﺇ</CommandAutoRepair>
  <!-- EN: If active, a mechanitor will automatically repair this mechanoid. Repairing a mechanoid drains its energy. -->
  <CommandAutoRepairDesc>ﻡﻮﻘﻴﺳ ،ًﺎﻄﺸﻧ ﻥﺎﻛ ﺍﺫﺇ\nﺍﺬﻫ ﺡﻼﺻﺈﺑ ﺭﻮﺘﻴﻧﺎﻜﻴﻤﻟﺍ\nﺡﻼﺻﺇ .ًﺎﻴﺋﺎﻘﻠﺗ ﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ\n.ﻪﺘﻗﺎﻃ ﻚﻠﻬﺘﺴﻳ ﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ</CommandAutoRepairDesc>

  <!-- EN: {0_labelShort} is deathresting. -->
  <CommandDisabledDeathresting>.ﺕﻮﻤﻟﺍ ﺕﺎﺒﺳ ﻲﻓ {0_labelShort}</CommandDisabledDeathresting>

  <!-- EN: Cancel vatgrowth -->
  <CommandCancelGrowth>ﺽﻮﺤﻟﺍ ﻮﻤﻧ ﺀﺎﻐﻟﺇ</CommandCancelGrowth>
  <!-- EN: Cancel vatgrowth for the current occupant. The occupant will be ejected. -->
  <CommandCancelGrowthDesc>ﻡﺪﺨﺘﺴﻤﻠﻟ ﺽﻮﺤﻟﺍ ﻮﻤﻧ ﺀﺎﻐﻟﺇ\n.ﻡﺪﺨﺘﺴﻤﻟﺍ ﺝﺍﺮﺧﺇ ﻢﺘﻴﺳ .ﻲﻟﺎﺤﻟﺍ</CommandCancelGrowthDesc>

  <!-- EN: Select overseer -->
  <CommandSelectOverseer>ﻑﺮﺸﻤﻟﺍ ﺭﺎﻴﺘﺧﺍ</CommandSelectOverseer>
  <!-- EN: Select the mechanitor who is the overseer of this mech. -->
  <CommandSelectOverseerDesc>ﻰﻠﻋ ﻑﺮﺸﻤﻟﺍ ﺭﻮﺘﻴﻧﺎﻜﻴﻤﻟﺍ ﺭﺎﻴﺘﺧﺍ\n.ﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ ﺍﺬﻫ</CommandSelectOverseerDesc>
  <!-- EN: No overseer. -->
  <CommandSelectOverseerDisabledDesc>.ﻑﺮﺸﻣ ﺪﺟﻮﻳ ﻻ</CommandSelectOverseerDisabledDesc>

  <!-- EN: Cancel extraction -->
  <CommandCancelExtraction>ﺝﺍﺮﺨﺘﺳﻻﺍ ﺀﺎﻐﻟﺇ</CommandCancelExtraction>
  <!-- EN: Cancel the extraction process. The contained person will be ejected. -->
  <CommandCancelExtractionDesc>ﻢﺘﻴﺳ .ﺝﺍﺮﺨﺘﺳﻻﺍ ﺔﻴﻠﻤﻋ ﺀﺎﻐﻟﺇ\n.ﻯﻮﺘﺤﻤﻟﺍ ﺺﺨﺸﻟﺍ ﺝﺍﺮﺧﺇ</CommandCancelExtractionDesc>

  <!-- EN: Summon mech threat... -->
  <CommandCallBossgroup>...ﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ ﺪﻳﺪﻬﺗ ﺀﺎﻋﺪﺘﺳﺍ</CommandCallBossgroup>
  <!-- EN: Summon an enemy leader mechanoid along with escorts.\n\nIf you defeat the leader mechanoid, it will drop a special chip which you can use to advance your own mechanoid technology.\n\nThere are three leader mechanoid types, each summoned a different way, each dropping a different type of chip. -->
  <CommandCallBossgroupDesc>ﻊﻣ ﻱﺩﺎﻌﻣ ﺪﺋﺎﻗ ﺪﻳﻮﻧﺎﻜﻴﻣ ﺀﺎﻋﺪﺘﺳﺍ\n.ﻦﻴﻘﻓﺍﺮﻣ\n\n،ﺪﺋﺎﻘﻟﺍ ﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ ﺖﻣﺰﻫ ﺍﺫﺇ\nﻚﻨﻜﻤﻳ ﺔﺻﺎﺧ ﺔﺤﻳﺮﺷ ﻂﻘﺴﻴﺳ\nﺔﻴﻨﻘﺗ ﺮﻳﻮﻄﺘﻟ ﺎﻬﻣﺍﺪﺨﺘﺳﺍ\n.ﻚﺑ ﺔﺻﺎﺨﻟﺍ ﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ\n\nﻦﻣ ﻉﺍﻮﻧﺃ ﺔﺛﻼﺛ ﻙﺎﻨﻫ\nﺎﻬﻨﻣ ﻞﻛ ،ﺓﺩﺎﻘﻟﺍ ﺕﺍﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ\nﻞﻛﻭ ،ﺔﻔﻠﺘﺨﻣ ﺔﻘﻳﺮﻄﺑ ﻰﻋﺪﺘﺴُﻳ\nﻦﻣ ًﺎﻔﻠﺘﺨﻣ ًﺎﻋﻮﻧ ﻂﻘﺴﻳ ﺎﻬﻨﻣ\n.ﺢﺋﺍﺮﺸﻟﺍ</CommandCallBossgroupDesc>

  <!-- EN: Toggle auto load {0} -->
  <CommandAutoLoad>{0} ﻲﺋﺎﻘﻠﺘﻟﺍ ﻞﻴﻤﺤﺘﻟﺍ ﻞﻳﺪﺒﺗ</CommandAutoLoad>
  <!-- EN: If active, colonists will automatically load this with {0}. -->
  <CommandAutoLoadDesc>ﻡﻮﻘﻴﺳ ،ًﺎﻄﺸﻧ ﻥﺎﻛ ﺍﺫﺇ\n{0} ـﺑ ﺍﺬﻫ ﻞﻴﻤﺤﺘﺑ ﻥﻭﺮﻤﻌﺘﺴﻤﻟﺍ\n.ًﺎﻴﺋﺎﻘﻠﺗ</CommandAutoLoadDesc>

  <!-- EN: Eject contents -->
  <CommandEjectContents>ﺕﺎﻳﻮﺘﺤﻤﻟﺍ ﺝﺍﺮﺧﺇ</CommandEjectContents>
  <!-- EN: Eject all contained {0} onto the ground. -->
  <CommandEjectContentsDesc>.ﺽﺭﻷﺍ ﻰﻟﺇ ﻯﻮﺘﺤﻤﻟﺍ {0} ﻞﻛ ﺝﺍﺮﺧﺇ</CommandEjectContentsDesc>

  <!-- EN: Select all mechs -->
  <CommandSelectAllMechs>ﺕﺍﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ ﻞﻛ ﺭﺎﻴﺘﺧﺍ</CommandSelectAllMechs>
  <!-- EN: Select all mechanoids controlled by this mechanitor. -->
  <CommandSelectAllMechsDesc>ﻲﺘﻟﺍ ﺕﺍﺪﻳﻮﻧﺎﻜﻴﻤﻟﺍ ﻞﻛ ﺭﺎﻴﺘﺧﺍ\n.ﺭﻮﺘﻴﻧﺎﻜﻴﻤﻟﺍ ﺍﺬﻫ ﺎﻬﺑ ﻢﻜﺤﺘﻳ</CommandSelectAllMechsDesc>

  <!-- EN: Turret enabled -->
  <CommandToggleTurret>ﻞﻌﻔﻣ ﻊﻓﺪﻤﻟﺍ</CommandToggleTurret>
  <!-- EN: Toggle turret being able to fire at will.\n\nWhen disabled, the turret will not automatically fire. This is useful while sneaking up on enemies. -->
  <CommandToggleTurretDesc>ﻕﻼﻃﺇ ﻰﻠﻋ ﻊﻓﺪﻤﻟﺍ ﺓﺭﺪﻗ ﻞﻳﺪﺒﺗ\n.ﺔﺒﻏﺮﻟﺍ ﺐﺴﺣ ﺭﺎﻨﻟﺍ\n\nﻊﻓﺪﻤﻟﺍ ﻖﻠﻄﻳ ﻦﻟ ،ﻞﻴﻄﻌﺘﻟﺍ ﺪﻨﻋ\nﺀﺎﻨﺛﺃ ﺪﻴﻔﻣ ﺍﺬﻫ .ًﺎﻴﺋﺎﻘﻠﺗ\n.ﺀﺍﺪﻋﻷﺍ ﻰﻟﺇ ﻞﻠﺴﺘﻟﺍ</CommandToggleTurretDesc>

  <!-- EN: Cancel scan -->
  <CommandCancelSubcoreScan>ﺢﺴﻤﻟﺍ ﺀﺎﻐﻟﺇ</CommandCancelSubcoreScan>
  <!-- EN: Cancel the scan process. The contained person will be ejected. -->
  <CommandCancelSubcoreScanDesc>ﺝﺍﺮﺧﺇ ﻢﺘﻴﺳ .ﺢﺴﻤﻟﺍ ﺔﻴﻠﻤﻋ ﺀﺎﻐﻟﺇ\n.ﻯﻮﺘﺤﻤﻟﺍ ﺺﺨﺸﻟﺍ</CommandCancelSubcoreScanDesc>

  <!-- EN: Force xenogerm implantation -->
  <ForceXenogermImplantation>ﺐﻳﺮﻐﻟﺍ ﺡﺎﻘﻠﻟﺍ ﻉﺭﺯ ﺭﺎﺒﺟﺇ</ForceXenogermImplantation>
  <!-- EN: Force this person to implant their xenogenes into another individual using a special injector organ. If this person's genes are currently regrowing, they will die in the process.\n\nWhen implanted, a xenogerm will overwrite the target's xenogenes. Germline genes will be unaffected. -->
  <ForceXenogermImplantationDesc>ﻪﺗﺎﻨﻴﺟ ﻉﺭﺯ ﻰﻠﻋ ﺺﺨﺸﻟﺍ ﺍﺬﻫ ﺭﺎﺒﺟﺇ\nﻡﺍﺪﺨﺘﺳﺎﺑ ﺮﺧﺁ ﺩﺮﻓ ﻲﻓ ﺔﺒﻳﺮﻐﻟﺍ\nﺕﺎﻨﻴﺟ ﺖﻧﺎﻛ ﺍﺫﺇ .ﺹﺎﺧ ﻦﻗﺎﺣ ﻮﻀﻋ\nﺕﻮﻤﻴﺳ ،ًﺎﻴﻟﺎﺣ ﻮﻤﻨﺗ ﺺﺨﺸﻟﺍ ﺍﺬﻫ\n.ﺔﻴﻠﻤﻌﻟﺍ ﻲﻓ\n\nﺐﻳﺮﻐﻟﺍ ﺡﺎﻘﻠﻟﺍ ﺐﺘﻜﻴﺳ ،ﻉﺭﺰﻟﺍ ﺪﻨﻋ\nﻦﻟﻭ .ﻑﺪﻬﻠﻟ ﺔﺒﻳﺮﻐﻟﺍ ﺕﺎﻨﻴﺠﻟﺍ ﻕﻮﻓ\n.ﺔﻟﻼﺴﻟﺍ ﺕﺎﻨﻴﺟ ﺮﺛﺄﺘﺗ</ForceXenogermImplantationDesc>
</LanguageData>