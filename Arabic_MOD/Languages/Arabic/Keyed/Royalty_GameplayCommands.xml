  <!-- EN: Call for aid using a special permit.\n\nEach type of aid may be used for free once, after which you must wait to use it for free again. You can use the aid more frequently, but it costs honor to do so. -->
  <CommandCallRoyalAidDesc>.ﺹﺎﺧ ﻥﺫﺇ ﻡﺍﺪﺨﺘﺳﺎﺑ ﺓﺪﻋﺎﺴﻤﻟﺍ ﺐﻠﻃ\n\nﻦﻣ ﻉﻮﻧ ﻞﻛ ﻡﺍﺪﺨﺘﺳﺍ ﻦﻜﻤﻳ\n،ﺓﺪﺣﺍﻭ ﺓﺮﻣ ًﺎﻧﺎﺠﻣ ﺓﺪﻋﺎﺴﻤﻟﺍ\nﺎﻬﻣﺍﺪﺨﺘﺳﻻ ﺭﺎﻈﺘﻧﻻﺍ ﺐﺠﻳ ﻚﻟﺫ ﺪﻌﺑﻭ\nﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ .ﻯﺮﺧﺃ ﺓﺮﻣ ًﺎﻧﺎﺠﻣ\n،ًﺍﺭﺍﺮﻜﺗ ﺮﺜﻛﺃ ﻞﻜﺸﺑ ﺓﺪﻋﺎﺴﻤﻟﺍ\n.ًﺎﻓﺮﺷ ﻒﻠﻜﻳ ﻚﻟﺫ ﻦﻜﻟ</CommandCallRoyalAidDesc>
  <!-- EN: Guests will not use their aid permits. -->
  <CommandCallRoyalAidLodger>ﺕﺎﻧﻭﺫﺃ ﻑﻮﻴﻀﻟﺍ ﻡﺪﺨﺘﺴﻳ ﻦﻟ\n.ﻢﻬﺑ ﺔﺻﺎﺨﻟﺍ ﺓﺪﻋﺎﺴﻤﻟﺍ</CommandCallRoyalAidLodger>
  <!-- EN: Slaves cannot use their permits. -->
  <CommandCallRoyalAidSlave>ﻡﺍﺪﺨﺘﺳﺍ ﺪﻴﺒﻌﻠﻟ ﻦﻜﻤﻳ ﻻ\n.ﻢﻬﺗﺎﻧﻭﺫﺃ</CommandCallRoyalAidSlave>
  <!-- EN: Your relations with {FACTION_name} are hostile. -->
  <CommandCallRoyalAidFactionHostile>.ﺔﻳﺩﺎﻌﻣ {FACTION_name} ﻊﻣ ﻚﺗﺎﻗﻼﻋ</CommandCallRoyalAidFactionHostile>
  <!-- EN: Free -->
