<LanguageData>
    <!-- EN: Arabic Auto Translation -->
    <AT_Name>Arabic Auto Translation</AT_Name>

    <!-- EN: Enable auto translation (default: On) -->
    <AT_Setting_EnableAutoTranslation>تفعيل الترجمة التلقائية (الافتراضي: تشغيل)</AT_Setting_EnableAutoTranslation>
    <!-- EN: When off, no network requests are made at all - only previously cached translations are applied. Useful when you are offline or want to stop translating. Fully applied after a game restart. -->
    <AT_Setting_EnableAutoTranslation_Tooltip>عند الإيقاف لا يرسل التعديل أي طلبات عبر الشبكة إطلاقاً، ويكتفي بتطبيق الترجمات المخزنة مؤقتاً سابقاً. مفيد عند عدم توفر الاتصال بالإنترنت أو عند الرغبة في إيقاف الترجمة. يكتمل التطبيق بعد إعادة تشغيل اللعبة.</AT_Setting_EnableAutoTranslation_Tooltip>
    <!-- EN: Only cached translations are used. -->
    <AT_Setting_AutoTranslationOff>يقتصر العمل على الترجمات المخزنة مؤقتاً.</AT_Setting_AutoTranslationOff>
    <!-- EN: Automatically translate newly added mods (default: On) -->
    <AT_Setting_AutoTranslateNewMods>ترجمة التعديلات المضافة حديثاً تلقائياً (الافتراضي: تشغيل)</AT_Setting_AutoTranslateNewMods>
    <!-- EN: When off, mods added after this point are excluded from translation by default. You can enable them manually in the Target Mods tab. -->
    <AT_Setting_AutoTranslateNewMods_Tooltip>عند الإيقاف تستثنى التعديلات المضافة بعد هذه اللحظة من الترجمة افتراضياً. يمكنك تفعيلها يدوياً من تبويب التعديلات المستهدفة.</AT_Setting_AutoTranslateNewMods_Tooltip>
    <!-- EN: Target language: Arabic (fixed) -->
    <AT_Setting_TargetLanguageFixed>لغة الترجمة: العربية (ثابتة)</AT_Setting_TargetLanguageFixed>
    <!-- EN: This mod translates into Arabic only. It does not matter which language the game itself is set to. -->
    <AT_Setting_TargetLanguageFixed_Tooltip>يترجم هذا التعديل إلى اللغة العربية فقط، بغض النظر عن اللغة التي تستخدمها اللعبة نفسها.</AT_Setting_TargetLanguageFixed_Tooltip>

    <!-- EN: Show original text on hover (default: Off): -->
    <AT_Setting_ShowOriginal>إظهار النص الأصلي عند تمرير المؤشر (الافتراضي: إيقاف):</AT_Setting_ShowOriginal>
    <!-- EN: When hovering over translated text, the original text will be displayed. Due to system limitations, this feature is not available for all translations. -->
    <AT_Setting_ShowOriginal_Tooltip>عند تمرير المؤشر فوق النص المترجم يظهر النص الأصلي. بسبب قيود النظام، هذه الميزة غير متاحة لجميع الترجمات.</AT_Setting_ShowOriginal_Tooltip>
    
    <!-- EN: Enable language detection (default: On): -->
    <AT_Setting_EnableLanguageDetection>تفعيل اكتشاف اللغة (الافتراضي: تشغيل):</AT_Setting_EnableLanguageDetection>
    <!-- EN: Automatically detects if text is already in the target language and skips translation. This prevents re-translating content that's already in Korean/Japanese/Chinese etc. when stored in the English folder. Recommended to keep enabled. -->
    <AT_Setting_EnableLanguageDetection_Tooltip>يكتشف تلقائياً ما إذا كان النص مكتوباً أصلاً بلغة الترجمة المستهدفة، فيتخطى ترجمته. يمنع ذلك إعادة ترجمة محتوى مكتوب مسبقاً بالكورية أو اليابانية أو الصينية وغيرها عند وجوده في مجلد اللغة الإنجليزية. يوصى بإبقاء هذا الخيار مفعلاً.</AT_Setting_EnableLanguageDetection_Tooltip>

    <!-- EN: ::Translation Settings:: -->
    <AT_Setting>::إعدادات الترجمة::</AT_Setting>
    <!-- EN: Note: Changes to the settings below require a game restart -->
    <AT_Setting_Note>ملاحظة: تتطلب التغييرات في الإعدادات أدناه إعادة تشغيل اللعبة</AT_Setting_Note>
    <!-- EN: Select translation engine (default: Yandex): -->
    <AT_Setting_SelectEngine>اختر محرك الترجمة (الافتراضي: Yandex):</AT_Setting_SelectEngine>
    <!-- EN: Switch to Google automatically if the selected engine is blocked (default: On) -->
    <AT_Setting_AutoFallback>التبديل إلى Google تلقائياً إذا تم حظر المحرك المحدد (الافتراضي: تشغيل)</AT_Setting_AutoFallback>
    <!-- EN: When the selected engine keeps answering with access denied (HTTP 401/403), for example because the service blocks your network, the rest of this game session is translated with Google instead. Your chosen engine is not changed and is tried again the next time the game starts. While this is active, the texts are sent to Google. -->
    <AT_Setting_AutoFallback_Tooltip>عندما يستمر المحرك المحدد في الرد برفض الوصول (HTTP 401/403)، مثلاً لأن الخدمة تحجب شبكتك، تتم ترجمة بقية جلسة اللعب هذه عبر Google بدلاً منه. لا يتغير المحرك الذي اخترته، وتتم تجربته من جديد عند تشغيل اللعبة في المرة القادمة. وأثناء عمل هذا الخيار يتم إرسال النصوص إلى Google.</AT_Setting_AutoFallback_Tooltip>
    <!-- EN: {0} refused the requests, so {1} is being used for this session. -->
    <AT_Setting_FallbackActive>رفض {0} الطلبات، لذلك يتم استخدام {1} في هذه الجلسة.</AT_Setting_FallbackActive>
    <!-- EN: This translation engine requires an API key. -->
    <AT_Setting_RequiresAPIKey>يتطلب محرك الترجمة هذا مفتاح API.</AT_Setting_RequiresAPIKey>
    <!-- EN: To use multiple API keys in rotation, separate them with commas (,). -->
    <AT_Setting_RequiresAPIKey_Tooltip>لاستخدام عدة مفاتيح API بالتناوب، افصل بينها بفواصل (,).</AT_Setting_RequiresAPIKey_Tooltip>
    <!-- EN: Add '::TEST::' prefix to translations (for testing) -->
    <AT_Setting_Test>إضافة البادئة '::TEST::' إلى الترجمات (للاختبار)</AT_Setting_Test>
    <!-- EN: &lt;= Test translation -->
    <AT_Setting_TestTranslation>&lt;= ترجمة تجريبية</AT_Setting_TestTranslation>
