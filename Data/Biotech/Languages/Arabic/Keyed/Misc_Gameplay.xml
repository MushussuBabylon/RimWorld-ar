  <!-- EN: cannot deathrest -->
  <CannotDeathrest>لا يمكنه السبات</CannotDeathrest>
  <!-- EN: Start deathrest -->
  <StartDeathrest>بدء سبات الموت</StartDeathrest>
  <!-- EN: Safely completing deathrest takes {MINDURATION}, but {PAWN_nameDef} has only been deathresting for {CURDURATION}.\n\nWaking {PAWN_nameDef} now would interrupt {PAWN_possessive} deathrest, throwing {PAWN_possessive} metabolism out of balance and making {PAWN_objective} sick for days to come.\n\nAre you sure you wish to wake {PAWN_objective}? -->
  <ConfirmExitDeathrestUnderMinDays>إتمام السبات بأمان يتطلب {MINDURATION}، لكن {PAWN_nameDef} لم يمضِ سوى {CURDURATION}.\n\nإيقاظـ{PAWN_objective} الآن سيقطع سباتـ{PAWN_possessive} ويخل بتوازن أيضـ{PAWN_possessive}، مما يصيبـ{PAWN_objective} بالمرض لأيام.\n\nأتريد إيقاظـ{PAWN_objective}؟</ConfirmExitDeathrestUnderMinDays>
