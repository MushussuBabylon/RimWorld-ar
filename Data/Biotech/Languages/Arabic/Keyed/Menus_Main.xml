<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>

  <!-- EN: Babies always healthy -->
  <Difficulty_BabiesAreHealthy_Label>رضع أصحاء دائماً</Difficulty_BabiesAreHealthy_Label>
  <!-- EN: Human babies are always born healthy. Mothers can't die in childbirth or have miscarriages. -->
  <Difficulty_BabiesAreHealthy_Info>يولد الرضع البشر أصحاء دائماً. لا يمكن أن تموت الأمهات أثناء الولادة أو يتعرضن للإجهاض.</Difficulty_BabiesAreHealthy_Info>
  <!-- EN: Disable children -->
  <Difficulty_NoBabiesOrChildren_Label>تعطيل الأطفال</Difficulty_NoBabiesOrChildren_Label>
  <!-- EN: Humans can't become pregnant. Human babies and children will never appear unless you choose them as starting colonists. -->
  <Difficulty_NoBabiesOrChildren_Info>لا يمكن للبشر الحمل. لن يظهر الرضع والأطفال البشر أبداً إلا إذا اخترتهم كمستعمرين مبتدئين.</Difficulty_NoBabiesOrChildren_Info>
  <!-- EN: Child aging rate -->
  <Difficulty_ChildAgingRate_Label>معدل تقدم عمر الأطفال</Difficulty_ChildAgingRate_Label>
  <!-- EN: Adjust the rate at which babies and children will age. Between ages 11 and 20, the child's aging rate will smoothly transition to the adult aging rate. -->
  <Difficulty_ChildAgingRate_Info>ضبط معدل تقدم عمر الرضع والأطفال. بين سن 11 و20، ينتقل معدل تقدم عمر الطفل تدريجياً إلى معدل تقدم عمر البالغين.</Difficulty_ChildAgingRate_Info>
  <!-- EN: Adult aging rate -->
  <Difficulty_AdultAgingRate_Label>معدل تقدم عمر البالغين</Difficulty_AdultAgingRate_Label>
  <!-- EN: Adjust the rate at which adults will age. -->
  <Difficulty_AdultAgingRate_Info>ضبط معدل تقدم عمر البالغين.</Difficulty_AdultAgingRate_Info>
  <!-- EN: Wastepack cocoon infestations -->
  <Difficulty_WastepackInfestationChanceFactor_Label>إصابات شرانق عبوات النفايات</Difficulty_WastepackInfestationChanceFactor_Label>
  <!-- EN: Adjust the chance that a dissolved wastepack will trigger the arrival of insect cocoons. -->
  <Difficulty_WastepackInfestationChanceFactor_Info>ضبط احتمال أن تؤدي عبوة نفايات متحللة إلى وصول شرانق الحشرات.</Difficulty_WastepackInfestationChanceFactor_Info>
  <!-- EN: Child raiders -->
  <Difficulty_ChildRaidersAllowed_Label>غزاة أطفال</Difficulty_ChildRaidersAllowed_Label>
  <!-- EN: Hostile raids will sometimes include children. -->
  <Difficulty_ChildRaidersAllowed_Info>ستشمل الغارات المعادية أحياناً أطفالاً.</Difficulty_ChildRaidersAllowed_Info>

  <!-- EN: Disabled because another setting prevents human birth. -->
  <BabiesAreHealthyDisableReason>معطّل لأن إعداداً آخر يمنع الولادة البشرية.</BabiesAreHealthyDisableReason>

  <!-- EN: Children -->
  <DifficultyChildrenSection>أطفال</DifficultyChildrenSection>

  <!-- Create/review world -->
  <!-- EN: Pollution -->
  <PlanetPollution>التلوث</PlanetPollution>
  
</LanguageData>
